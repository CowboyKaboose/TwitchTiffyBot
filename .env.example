# Example configuration - Copy this file to .env and fill in your actual values
# NEVER COMMIT YOUR ACTUAL .env FILE TO GIT!

# --- Discord ---
# Get from Discord Developer Portal -> Your Application -> Bot -> Token
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Channel IDs (Enable Developer Mode in Discord: User Settings -> Advanced)
# Right-click channel -> Copy Channel ID
VIP_CHANNEL_ID=YOUR_VIP_DISCORD_CHANNEL_ID_HERE
MOD_CHANNEL_ID=YOUR_MOD_DISCORD_CHANNEL_ID_HERE

# User IDs allowed to use admin commands (comma-separated, NO spaces)
# Right-click user -> Copy User ID
ALLOWED_USER_IDS=YOUR_USER_ID_1,YOUR_USER_ID_2

# --- Twitch ---
# Get from Twitch Developer Console -> Your Application -> Manage
TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID_HERE
TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET_HERE
